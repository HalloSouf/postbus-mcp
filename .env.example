# Required. Encrypts app passwords at rest. Generate: openssl rand -hex 32
# Lose it and every mailbox has to be linked again.
MASTER_KEY=

PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/postbus.db

# Hostname Traefik routes to this container. Only used by docker-compose.yml.
PUBLIC_HOST=mcp.example.com

# Trust X-Forwarded-* headers. Only turn this on when a reverse proxy such as
# Traefik sits in front; without one, any client could spoof its own address.
TRUST_PROXY=false
MAX_BODY_SIZE=4mb
MAIL_TIMEOUT_MS=30000

# Largest single message fetched from IMAP, in bytes. Bigger messages are read
# up to this point and marked as cut off, so one mail with a huge attachment
# cannot pull the server over.
MAX_MESSAGE_BYTES=2097152

# Tool calls allowed per token per minute, and how many mailboxes one user may
# link.
RATE_LIMIT_PER_MINUTE=60
MAX_ACCOUNTS_PER_USER=20

# Optional: Gmail API provider. Not needed for IMAP/SMTP.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAUTH_CALLBACK_PORT=53682
